node_modules
dist
.DS_Store
.env
.env.*

# Ignore the output video from Git but not videos you import into src/.
out

# Local runtime state.
.runtime/
public/generated/
remotion-studio.*.log
*.log
__pycache__/
*.pyc

# Do not vendor nested Git metadata from source references.
asset-source/**/.git/

# Local visual/debug artifacts.
screenshots/

# Local Vercel project binding.
.vercel

# Local-only RemotionLab code references.
.env.example
asset-source/remotionlab/

# Upstream reference clone (https://github.com/av/remotion-bits), local only; not imported by code.
asset-source/programmatic-visual-assets/remotion-bits/

# earth3d: terrain tiles (~775 MB) and the raw download cache are rebuilt by
# src/earth3d/pipeline/build_all.py and checked against src/earth3d/assets.sha256.
# The small data files in src/earth3d/assets/ (cities, rivers, borders) are committed.
src/earth3d/assets/tiles/*
!src/earth3d/assets/tiles/.gitkeep
src/earth3d/.cache/

  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@react-three/fiber": "^9.1.0",
    "@remotion/bundler": "4.0.542",
    "@remotion/cli": "4.0.542",
    "@remotion/player": "4.0.542",
    "@remotion/renderer": "4.0.542",
    "@remotion/tailwind-v4": "4.0.542",
    "@remotion/three": "4.0.542",
    "d3-geo": "^3.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.542",
    "roughjs": "^4.6.6",
    "tailwindcss": "4.0.0",

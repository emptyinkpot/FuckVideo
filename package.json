    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/d3-geo": "^3.1.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.176.0",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  },
  "scripts": {
    "dev": "remotion studio",
    "dev:video": "node videolab/server/start.mjs",
    "build": "remotion bundle",
    "plan-scenes": "node pipeline/scene-planner.mjs",
    "text-to-scenes-video": "node pipeline/text-to-scenes-video.mjs",
    "text-to-scenes-tts-video": "node pipeline/text-to-scenes-tts-video.mjs",
    "import-mixkit-reveal": "node pipeline/import-mixkit-reveal.mjs",
    "index-assets": "node pipeline/asset-indexer.mjs",
    "index-assets:v2": "node pipeline/asset-indexer.mjs",
    "material:seed": "node pipeline/material-seed.mjs",
    "match-assets": "node pipeline/scene-asset-planner.mjs",
    "validate-animation-contracts": "node pipeline/animation-contracts.mjs",
    "smoke:minimal": "node pipeline/smoke-minimal-pipeline.mjs",
    "test:material-seed": "node tests/validate-material-seed.mjs",
    "test:material-vector-service": "node tests/validate-material-vector-service.mjs",
    "resolve-evidence": "node pipeline/evidence-resolver.mjs",
    "export-project": "node pipeline/export-video-project.mjs",
    "text-to-video": "node pipeline/text-to-video.mjs",
    "upgrade": "remotion upgrade",
    "lint": "eslint src videolab/ui/src && tsc && tsc -p videolab/ui",
    "verify:upstream": "npm run lint && npm run videolab:build && node tests/verify-upstream.mjs && node tests/videolab-smoke.mjs",
    "videolab": "node videolab/server/server.mjs",
    "videolab:build": "vite build videolab/ui",
    "videolab:dev": "vite videolab/ui",
    "videolab:typecheck": "tsc -p videolab/ui",
    "test:videolab": "node tests/videolab-smoke.mjs"
  },
  "sideEffects": [
    "*.css"
  ]
}

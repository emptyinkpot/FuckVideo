{
  "projectName": "FuckVideo",
  "purpose": {
    "oneLine": "A Remotion project for code-driven animations.",
    "coreCapability": "Reusable React animation compositions rendered by Remotion.",
    "canonicalPipeline": [
      "Edit animation components in src/",
      "Preview and tune compositions in Remotion Studio",
      "Render compositions with Remotion"
    ]
  },
  "repository": {
    "githubIdentifier": "emptyinkpot/FuckVideo",
    "url": "https://github.com/emptyinkpot/FuckVideo"
  },
  "framework": {
    "name": "Remotion",
    "version": "4.0.545",
    "entry": "src/index.ts",
    "compositionRegistry": "src/Root.tsx"
  },
  "runtimeAssets": [
    "public/maps/",
    "public/geojson/",
    "public/historical-maps/"
  ],
  "commands": {
    "studio": "npm run dev",
    "bundle": "npm run build",
    "verify": "npm run verify:upstream"
  }
}
